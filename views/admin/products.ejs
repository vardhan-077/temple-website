<%- include('../partials/_admin-layout-top') %>

<h1>Products</h1>
<p class="hint" style="margin-top:-8px;">Items in the temple shop - pooja items, merchandise, books, clothing, jewellery replicas and so on. Turn "Show on site" off for anything sold out instead of deleting it.</p>

<div class="panel">
  <h2>Add a Product</h2>
  <form method="POST" action="/admin/products/add" enctype="multipart/form-data">
    <div class="form-row">
      <div class="form-group">
        <label for="productName">Name</label>
        <input type="text" id="productName" name="name" maxlength="120" required>
      </div>
      <div class="form-group">
        <label for="productPrice">Price (&#8377;)</label>
        <input type="number" id="productPrice" name="price" min="1" step="1" required>
      </div>
    </div>
    <div class="form-group">
      <label for="productDescription">Description (optional)</label>
      <textarea id="productDescription" name="description" rows="2" maxlength="500"></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="productCategory">Category</label>
        <input type="text" id="productCategory" name="category" list="productCategoryOptions" maxlength="80" placeholder="e.g. Pooja Items & Temple Merchandise">
        <datalist id="productCategoryOptions">
          <option value="Pooja Items & Temple Merchandise">
          <option value="Books, Clothing & Jewellery">
        </datalist>
      </div>
      <div class="form-group">
        <label for="productOrder">Display Order</label>
        <input type="number" id="productOrder" name="order" value="0">
      </div>
    </div>
    <div class="form-group">
      <label for="productImage">Photo</label>
      <input type="file" id="productImage" name="image" accept="image/*">
      <img data-preview-for="productImage" style="display:block; margin-top:10px; max-width:220px; border-radius:var(--radius-sm); border:1px solid var(--cream-dark);">
    </div>
    <button type="submit" class="btn btn-primary">Add Product</button>
  </form>
</div>

<% if (!products.length) { %>
  <p class="empty-hint">No products added yet.</p>
<% } else { %>
  <div class="thumb-grid">
    <% products.forEach(function(p) { %>
      <div class="thumb-card">
        <img src="<%= p.imageUrl || '/images/placeholders/gallery-temple.svg' %>" alt="<%= p.name %>">
        <div class="thumb-body">
          <p><strong><%= p.name %></strong><br><%= formatINR(p.price) %> &middot; <%= p.category %></p>
          <p class="hint" style="margin:4px 0 10px;"><%= p.isActive ? 'Visible on site' : 'Hidden (sold out / paused)' %></p>
          <form method="POST" action="/admin/products/<%= p._id %>/toggle-active">
            <button type="submit" class="btn btn-outline btn-sm btn-block"><%= p.isActive ? 'Hide from site' : 'Show on site' %></button>
          </form>
          <form method="POST" action="/admin/products/<%= p._id %>/delete" data-confirm="Delete this product? This cannot be undone." style="margin-top:8px;">
            <button type="submit" class="btn btn-danger btn-sm btn-block">Delete</button>
          </form>
          <details style="margin-top:8px;">
            <summary class="btn btn-outline btn-sm btn-block" style="cursor:pointer; text-align:center;">Edit</summary>
            <form method="POST" action="/admin/products/<%= p._id %>/edit" enctype="multipart/form-data" style="margin-top:10px;">
              <div class="form-group">
                <label>Name</label>
                <input type="text" name="name" value="<%= p.name %>" maxlength="120" required>
              </div>
              <div class="form-group">
                <label>Price (&#8377;)</label>
                <input type="number" name="price" value="<%= p.price %>" min="1" step="1" required>
              </div>
              <div class="form-group">
                <label>Description</label>
                <textarea name="description" rows="2" maxlength="500"><%= p.description %></textarea>
              </div>
              <div class="form-group">
                <label>Category</label>
                <input type="text" name="category" value="<%= p.category %>" list="productCategoryOptions" maxlength="80">
              </div>
              <div class="form-group">
                <label>Display Order</label>
                <input type="number" name="order" value="<%= p.order %>">
              </div>
              <div class="form-group">
                <label>Replace Photo (optional)</label>
                <input type="file" name="image" accept="image/*">
                <p class="hint">Leave blank to keep the current photo.</p>
              </div>
              <button type="submit" class="btn btn-primary btn-sm btn-block">Save Changes</button>
            </form>
          </details>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/_admin-layout-bottom') %>
