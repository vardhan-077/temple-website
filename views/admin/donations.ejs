<%- include('../partials/_admin-layout-top') %>

<h1>Donations</h1>

<div class="stat-grid" style="grid-template-columns:repeat(2,1fr); max-width:500px;">
  <div class="stat-card">
    <span class="value"><%= formatINR(totals.total) %></span>
    <span class="label">Total Raised (paid)</span>
  </div>
  <div class="stat-card">
    <span class="value"><%= totals.count %></span>
    <span class="label">Paid Donations</span>
  </div>
</div>

<div class="panel">
  <h2>Record a Manual / Offline Donation</h2>
  <p class="hint" style="margin-top:-8px; margin-bottom:14px;">Use this for cash, cheque or direct bank transfer donations so they're included in the progress bar and leaderboard.</p>
  <form method="POST" action="/admin/donations/manual">
    <div class="form-row">
      <div class="form-group">
        <label for="name">Donor Name</label>
        <input type="text" id="name" name="name" placeholder="Anonymous Devotee">
      </div>
      <div class="form-group">
        <label for="amount">Amount (&#8377;)</label>
        <input type="number" id="amount" name="amount" min="1" required>
      </div>
    </div>
    <div class="form-group">
      <label for="note">Internal Note (optional, not shown publicly)</label>
      <input type="text" id="note" name="note" placeholder="e.g. Cash handed at temple office on 12 Sep">
    </div>
    <div class="form-group checkbox-row">
      <input type="checkbox" id="isAnonymous" name="isAnonymous">
      <label for="isAnonymous">Hide name on public leaderboard</label>
    </div>
    <button type="submit" class="btn btn-primary">Add Donation</button>
  </form>
</div>

<div class="panel">
  <h2>All Donations</h2>
  <% if (!donations.length) { %>
    <p class="empty-hint">No donations recorded yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Date</th><th>Donor</th><th>Amount</th><th>Method</th><th>Status</th><th>On Leaderboard</th><th>Actions</th></tr></thead>
        <tbody>
          <% donations.forEach(function(d) { %>
          <tr>
            <td><%= new Date(d.createdAt).toLocaleDateString('en-IN') %></td>
            <td>
              <%= d.name %><% if (d.isAnonymous) { %> <span class="badge badge-manual">anon</span><% } %>
              <% if (d.message) { %><br><span class="hint" style="white-space:normal;">&#128172; <%= d.message %></span><% } %>
              <% if (d.note) { %><br><span class="hint" style="white-space:normal;">&#128221; <%= d.note %></span><% } %>
            </td>
            <td><%= formatINR(d.amount) %></td>
            <td><span class="badge badge-manual"><%= d.method %></span></td>
            <td><span class="badge badge-<%= d.status %>"><%= d.status %></span></td>
            <td>
              <form method="POST" action="/admin/donations/<%= d._id %>/toggle-visibility" class="inline-form">
                <button type="submit" class="btn btn-outline btn-sm"><%= d.visibleOnLeaderboard ? 'Visible' : 'Hidden' %></button>
              </form>
            </td>
            <td>
              <form method="POST" action="/admin/donations/<%= d._id %>/delete" class="inline-form" data-confirm="Delete this donation record permanently?">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/_admin-layout-bottom') %>
