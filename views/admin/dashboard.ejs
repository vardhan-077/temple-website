<%- include('../partials/_admin-layout-top') %>

<h1>Dashboard</h1>
<p class="hint" style="margin-bottom:20px;">Welcome back<% if (currentAdminUsername) { %>, <%= currentAdminUsername %><% } %>. Here's how things stand today.</p>

<div class="stat-grid">
  <div class="stat-card">
    <span class="value"><%= formatINR(totals.total) %></span>
    <span class="label">Total Raised</span>
  </div>
  <div class="stat-card">
    <span class="value"><%= totals.count %></span>
    <span class="label">Total Donors</span>
  </div>
  <div class="stat-card">
    <span class="value"><%= percent %>%</span>
    <span class="label">Of Donation Goal</span>
  </div>
  <div class="stat-card">
    <span class="value"><%= unreadMessages %></span>
    <span class="label">Unread Messages</span>
  </div>
</div>

<div class="panel">
  <div class="panel-header">
    <h2>Recent Donations</h2>
    <a href="/admin/donations" class="btn btn-outline btn-sm">View All</a>
  </div>
  <% if (!recentDonations.length) { %>
    <p class="empty-hint">No donations recorded yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Donor</th><th>Amount</th><th>Method</th><th>Status</th><th>Date</th></tr></thead>
        <tbody>
          <% recentDonations.forEach(function(d) { %>
          <tr>
            <td><%= d.isAnonymous ? 'Anonymous Devotee' : d.name %></td>
            <td><%= formatINR(d.amount) %></td>
            <td><span class="badge badge-manual"><%= d.method %></span></td>
            <td><span class="badge badge-<%= d.status %>"><%= d.status %></span></td>
            <td><%= new Date(d.createdAt).toLocaleDateString('en-IN') %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="panel">
  <div class="panel-header"><h2>Quick Links</h2></div>
  <div class="action-row">
    <a href="/admin/settings" class="btn btn-outline btn-sm">Edit Temple Settings</a>
    <a href="/admin/gallery" class="btn btn-outline btn-sm">Manage Gallery (<%= galleryCount %>)</a>
    <a href="/admin/committee" class="btn btn-outline btn-sm">Manage Committee (<%= committeeCount %>)</a>
    <a href="/admin/donations" class="btn btn-outline btn-sm">Add Manual Donation</a>
  </div>
</div>

<%- include('../partials/_admin-layout-bottom') %>
