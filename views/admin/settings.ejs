<%- include('../partials/_admin-layout-top') %>

<h1>Temple Settings</h1>
<p class="hint" style="margin-bottom:20px;">Everything here updates the public website immediately after saving.</p>

<form method="POST" action="/admin/settings" enctype="multipart/form-data">

  <div class="panel">
    <h2>General Information</h2>
    <div class="form-row">
      <div class="form-group">
        <label for="templeName">Temple Name</label>
        <input type="text" id="templeName" name="templeName" value="<%= settings.templeName %>" required>
      </div>
      <div class="form-group">
        <label for="deityName">Deity Name</label>
        <input type="text" id="deityName" name="deityName" value="<%= settings.deityName %>">
      </div>
    </div>
    <div class="form-group">
      <label for="tagline">Tagline</label>
      <input type="text" id="tagline" name="tagline" value="<%= settings.tagline %>" maxlength="140">
    </div>
    <div class="form-group">
      <label for="aboutShort">About / Homepage Description</label>
      <textarea id="aboutShort" name="aboutShort" rows="4"><%= settings.aboutShort %></textarea>
    </div>
    <div class="form-group">
      <label for="address">Address</label>
      <textarea id="address" name="address" rows="2"><%= settings.address %></textarea>
    </div>
    <div class="form-group">
      <label for="locationShort">Short Location (shown on the homepage banner)</label>
      <input type="text" id="locationShort" name="locationShort" value="<%= settings.locationShort %>" placeholder="e.g. Gullapudi Village &bull; NTR District" maxlength="80">
      <p class="hint">A short line shown under the temple name on the homepage photo. Leave blank to hide it.</p>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="phone">Phone Number</label>
        <input type="text" id="phone" name="phone" value="<%= settings.phone %>">
      </div>
      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" value="<%= settings.email %>">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="whatsappNumber">WhatsApp Number</label>
        <input type="text" id="whatsappNumber" name="whatsappNumber" value="<%= settings.whatsappNumber %>" placeholder="919000000000">
        <p class="hint">Include country code, digits only (e.g. 91 for India). Powers the floating WhatsApp button.</p>
      </div>
      <div class="form-group">
        <label for="mapEmbedUrl">Google Maps Embed URL (optional)</label>
        <input type="text" id="mapEmbedUrl" name="mapEmbedUrl" value="<%= settings.mapEmbedUrl %>" placeholder="https://www.google.com/maps/embed?...">
      </div>
    </div>
  </div>

  <div class="panel">
    <h2>Homepage Highlights</h2>
    <p class="hint" style="margin-top:-6px;">The 4-box highlight strip shown near the top of the homepage - e.g. "100+ Years of Heritage".</p>
    <% var highlightIconOptions = [
      ['temple', 'Temple'],
      ['families', 'Families'],
      ['calendar', 'Calendar'],
      ['globe', 'Globe'],
      ['heart', 'Heart'],
      ['star', 'Star'],
    ]; %>
    <% var highlightRows = (settings.highlights && settings.highlights.length ? settings.highlights : [{}, {}, {}, {}]); %>
    <% highlightRows.forEach(function(h, i) { %>
      <div class="form-row" style="align-items:flex-end;">
        <div class="form-group" style="max-width:150px;">
          <label for="highlightIcon<%= i %>">Icon</label>
          <select id="highlightIcon<%= i %>" name="highlightIcon<%= i %>">
            <% highlightIconOptions.forEach(function(opt) { %>
              <option value="<%= opt[0] %>" <%= h.icon === opt[0] ? 'selected' : '' %>><%= opt[1] %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="highlightValue<%= i %>">Big Text</label>
          <input type="text" id="highlightValue<%= i %>" name="highlightValue<%= i %>" value="<%= h.value || '' %>" placeholder="e.g. 100+" maxlength="40">
        </div>
        <div class="form-group">
          <label for="highlightLabel<%= i %>">Caption</label>
          <input type="text" id="highlightLabel<%= i %>" name="highlightLabel<%= i %>" value="<%= h.label || '' %>" placeholder="e.g. Years of Heritage" maxlength="60">
        </div>
      </div>
    <% }) %>
  </div>

  <div class="panel">
    <h2>Bank &amp; UPI Details</h2>
    <div class="form-row">
      <div class="form-group">
        <label for="accountName">Account Name</label>
        <input type="text" id="accountName" name="accountName" value="<%= settings.bankDetails.accountName %>">
      </div>
      <div class="form-group">
        <label for="accountNumber">Account Number</label>
        <input type="text" id="accountNumber" name="accountNumber" value="<%= settings.bankDetails.accountNumber %>">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="ifsc">IFSC Code</label>
        <input type="text" id="ifsc" name="ifsc" value="<%= settings.bankDetails.ifsc %>">
      </div>
      <div class="form-group">
        <label for="bankName">Bank Name</label>
        <input type="text" id="bankName" name="bankName" value="<%= settings.bankDetails.bankName %>">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="branch">Branch</label>
        <input type="text" id="branch" name="branch" value="<%= settings.bankDetails.branch %>">
      </div>
      <div class="form-group">
        <label for="upiId">UPI ID</label>
        <input type="text" id="upiId" name="upiId" value="<%= settings.upiId %>" placeholder="yourtemple@upi">
      </div>
    </div>
    <div class="form-group">
      <label for="upiQrImage">UPI QR Code Image</label>
      <img data-preview-for="upiQrImage" src="<%= settings.upiQrImageUrl || '/images/placeholders/upi-qr-placeholder.svg' %>" alt="" style="width:100px;height:100px;object-fit:cover;border-radius:8px;margin-bottom:8px;display:block;">
      <input type="file" id="upiQrImage" name="upiQrImage" accept="image/*">
    </div>
    <div class="form-group">
      <label for="taxInfo">Tax Exemption / Trust Registration Info (optional)</label>
      <textarea id="taxInfo" name="taxInfo" rows="2" placeholder="e.g. Donations eligible under Section 80G. PAN: ..."><%= settings.taxInfo %></textarea>
    </div>
  </div>

  <p class="hint" style="margin:-6px 0 20px;">Looking for the festival countdown? It now has its own <a href="/admin/festivals">Festivals</a> page, where you can add as many ongoing or upcoming festivals as you like.</p>

  <div class="panel">
    <h2>Social Links (optional)</h2>
    <div class="form-row">
      <div class="form-group">
        <label for="facebook">Facebook URL</label>
        <input type="text" id="facebook" name="facebook" value="<%= settings.socialLinks.facebook %>">
      </div>
      <div class="form-group">
        <label for="instagram">Instagram URL</label>
        <input type="text" id="instagram" name="instagram" value="<%= settings.socialLinks.instagram %>">
      </div>
    </div>
    <div class="form-group">
      <label for="youtube">YouTube URL</label>
      <input type="text" id="youtube" name="youtube" value="<%= settings.socialLinks.youtube %>">
    </div>
  </div>

  <div class="panel">
    <h2>Branding</h2>
    <div class="form-row">
      <div class="form-group">
        <label for="logo">Logo</label>
        <img data-preview-for="logo" src="<%= settings.logoUrl || '/images/placeholders/logo-placeholder.svg' %>" alt="" style="width:70px;height:70px;object-fit:cover;border-radius:50%;margin-bottom:8px;display:block;">
        <input type="file" id="logo" name="logo" accept="image/*">
      </div>
      <div class="form-group">
        <label for="heroImage">Homepage Hero Background</label>
        <img data-preview-for="heroImage" src="<%= settings.heroImageUrl || '/images/placeholders/hero-placeholder.svg' %>" alt="" style="width:100%;max-width:220px;aspect-ratio:16/9;object-fit:cover;border-radius:8px;margin-bottom:8px;display:block;">
        <input type="file" id="heroImage" name="heroImage" accept="image/*">
      </div>
    </div>
    <div class="form-group">
      <label for="aboutImage">About Section Photo</label>
      <img data-preview-for="aboutImage" src="<%= settings.aboutImageUrl || '/images/placeholders/gallery-temple.svg' %>" alt="" style="width:100%;max-width:220px;aspect-ratio:4/3;object-fit:cover;border-radius:8px;margin-bottom:8px;display:block;">
      <input type="file" id="aboutImage" name="aboutImage" accept="image/*">
      <p class="hint">Shown alongside the "About" text on the homepage. Leave empty to show text only.</p>
    </div>
  </div>

  <button type="submit" class="btn btn-primary">Save Settings</button>
</form>

<%- include('../partials/_admin-layout-bottom') %>
