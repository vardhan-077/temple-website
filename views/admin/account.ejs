<%- include('../partials/_admin-layout-top') %>

<h1>My Account</h1>

<div class="panel" style="max-width:480px;">
  <h2>Change Password</h2>
  <p class="hint" style="margin-top:-8px; margin-bottom:14px;">Logged in as <strong><%= currentAdminUsername %></strong></p>
  <form method="POST" action="/admin/account/password">
    <div class="form-group">
      <label for="currentPassword">Current Password</label>
      <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password">
    </div>
    <div class="form-group">
      <label for="newPassword">New Password</label>
      <input type="password" id="newPassword" name="newPassword" required minlength="8" autocomplete="new-password">
      <p class="hint">At least 8 characters.</p>
    </div>
    <div class="form-group">
      <label for="confirmPassword">Confirm New Password</label>
      <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8" autocomplete="new-password">
    </div>
    <button type="submit" class="btn btn-primary">Update Password</button>
  </form>
</div>

<%- include('../partials/_admin-layout-bottom') %>
