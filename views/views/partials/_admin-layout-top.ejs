<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pageTitle %> | Admin | <%= settings.templeName %></title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="<%= settings.logoUrl || '/images/placeholders/logo-placeholder.svg' %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<header class="admin-topbar">
  <button class="admin-menu-toggle" id="adminMenuToggle" aria-label="Toggle menu">&#9776;</button>
  <a href="/admin" class="brand">
    <img src="<%= settings.logoUrl || '/images/placeholders/logo-placeholder.svg' %>" alt="">
    <span><%= settings.templeName %></span>
  </a>
  <div class="admin-topbar-actions">
    <a href="/" target="_blank" rel="noopener">View Site &#8599;</a>
  </div>
</header>

<div class="admin-backdrop" id="adminBackdrop"></div>

<div class="admin-shell">
  <aside class="admin-sidebar" id="adminSidebar">
    <a href="/admin" class="<%= activeAdminNav === 'dashboard' ? 'active' : '' %>"><span class="icon">&#128202;</span> Dashboard</a>
    <a href="/admin/settings" class="<%= activeAdminNav === 'settings' ? 'active' : '' %>"><span class="icon">&#9881;</span> Temple Settings</a>
    <a href="/admin/gallery" class="<%= activeAdminNav === 'gallery' ? 'active' : '' %>"><span class="icon">&#127917;</span> Gallery</a>
    <a href="/admin/history" class="<%= activeAdminNav === 'history' ? 'active' : '' %>"><span class="icon">&#128220;</span> History</a>
    <a href="/admin/committee" class="<%= activeAdminNav === 'committee' ? 'active' : '' %>"><span class="icon">&#128101;</span> Committee</a>
    <a href="/admin/programs" class="<%= activeAdminNav === 'programs' ? 'active' : '' %>"><span class="icon">&#128197;</span> Programs</a>
    <a href="/admin/festivals" class="<%= activeAdminNav === 'festivals' ? 'active' : '' %>"><span class="icon">&#127881;</span> Festivals</a>
    <a href="/admin/shilapalaka" class="<%= activeAdminNav === 'shilapalaka' ? 'active' : '' %>"><span class="icon">&#128330;</span> Shilapalaka</a>
    <a href="/admin/announcements" class="<%= activeAdminNav === 'announcements' ? 'active' : '' %>"><span class="icon">&#128226;</span> Announcements</a>
    <a href="/admin/donors" class="<%= activeAdminNav === 'donors' ? 'active' : '' %>"><span class="icon">&#128591;</span> Donors</a>
    <a href="/admin/products" class="<%= activeAdminNav === 'products' ? 'active' : '' %>"><span class="icon">&#128717;</span> Products</a>
    <a href="/admin/orders" class="<%= activeAdminNav === 'orders' ? 'active' : '' %>"><span class="icon">&#128230;</span> Orders</a>
    <a href="/admin/messages" class="<%= activeAdminNav === 'messages' ? 'active' : '' %>"><span class="icon">&#9993;</span> Messages</a>
    <a href="/admin/account" class="<%= activeAdminNav === 'account' ? 'active' : '' %>"><span class="icon">&#128100;</span> My Account</a>
    <form action="/admin/logout" method="POST">
      <button type="submit" class="logout-btn"><span class="icon">&#8618;</span> Logout</button>
    </form>
  </aside>

  <div class="admin-content">
    <% if (typeof flashSuccess !== 'undefined') { %>
      <% flashSuccess.forEach(function(m) { %><div class="alert alert-success"><%= m %></div><% }) %>
      <% flashError.forEach(function(m) { %><div class="alert alert-error"><%= m %></div><% }) %>
    <% } %>
