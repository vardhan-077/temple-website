<%- include('../partials/_layout-top') %>

<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Daily Schedule</span>
      <h2>Daily Pooja Timings</h2>
      <div class="divider-motif">&#128330;</div>
      <p>Join us for daily worship at the temple - here is our regular schedule of poojas and rituals.</p>
    </div>

    <% if (!timings.length) { %>
      <div class="empty-state"><p>Our pooja schedule will be added soon.</p></div>
    <% } else { %>
      <div class="card" style="max-width:700px; margin:0 auto;">
        <div class="card-body" style="padding:0;">
          <table class="timing-table">
            <thead>
              <tr><th>Activity</th><th>Time</th></tr>
            </thead>
            <tbody>
              <% timings.forEach(function(t) { %>
              <tr>
                <td>
                  <strong><%= t.name %></strong>
                  <% if (t.description) { %><span class="timing-note"><%= t.description %></span><% } %>
                </td>
                <td class="timing-time"><%= t.time %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/_layout-bottom') %>
