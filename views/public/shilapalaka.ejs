<%- include('../partials/_layout-top') %>

<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Founding Donors</span>
      <h2>Shilapalakas</h2>
      <div class="divider-motif">&#128330;</div>
      <p>Stone plaques honoring those who gave land, materials, and funds during the temple's construction.</p>
    </div>

    <% if (!photos.length) { %>
      <div class="empty-state"><p>Shilapalaka photos will be added soon.</p></div>
    <% } else { %>
      <div class="gallery-grid shilapalaka-grid">
        <% photos.forEach(function(p) { %>
          <div class="gallery-item" data-full="<%= p.imageUrl %>" data-caption="<%= p.caption %>">
            <img src="<%= p.imageUrl %>" alt="<%= p.caption || 'Shilapalaka - temple construction donor plaque' %>" loading="lazy">
            <% if (p.caption) { %><span class="caption"><%= p.caption %></span><% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/_layout-bottom') %>
