<%- include('../partials/_layout-top') %>

<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Get In Touch</span>
      <h2>Contact Us</h2>
      <div class="divider-motif">&#9742;</div>
    </div>

    <div class="grid grid-2" style="align-items:start;">
      <div class="card">
        <div class="card-body">
          <% flashSuccess.forEach(function(m) { %><div class="alert alert-success"><%= m %></div><% }) %>
          <% flashError.forEach(function(m) { %><div class="alert alert-error"><%= m %></div><% }) %>

          <form method="POST" action="/contact">
            <div class="form-group">
              <label for="name">Your Name</label>
              <input type="text" id="name" name="name" required maxlength="100">
            </div>
            <div class="form-group">
              <label for="email">Email (optional)</label>
              <input type="email" id="email" name="email" maxlength="200">
            </div>
            <div class="form-group">
              <label for="phone">Phone (optional)</label>
              <input type="tel" id="phone" name="phone" maxlength="30">
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" required maxlength="1000"></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Send Message</button>
          </form>
        </div>
      </div>

      <div>
        <div class="card" style="margin-bottom:20px;">
          <div class="card-body">
            <h3>Visit Us</h3>
            <p class="muted" style="margin-bottom:4px;"><%= settings.address %></p>
            <p class="muted" style="margin-bottom:4px;">Phone: <a href="tel:<%= settings.phone.replace(/\s+/g,'') %>"><%= settings.phone %></a></p>
            <p class="muted">Email: <a href="mailto:<%= settings.email %>"><%= settings.email %></a></p>
            <% if (settings.whatsappNumber) { %>
            <p style="margin-top:14px;">
              <a class="btn btn-maroon btn-sm" target="_blank" rel="noopener"
                 href="https://wa.me/<%= settings.whatsappNumber.replace(/\D/g,'') %>">Message us on WhatsApp</a>
            </p>
            <% } %>
          </div>
        </div>
        <% if (settings.mapEmbedUrl) { %>
        <div class="card">
          <iframe src="<%= settings.mapEmbedUrl %>" width="100%" height="280" style="border:0; display:block;" loading="lazy"></iframe>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/_layout-bottom') %>
